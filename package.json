{
  "name": "facemood-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build && node scripts/build_retirement_worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/fetch_assets.mjs",
    "predev": "node scripts/build_worker.mjs",
    "prebuild": "node scripts/build_worker.mjs",
    "worker": "node scripts/build_worker.mjs",
    "rollback:baseline": "node scripts/rollback_baseline.mjs && npm run build",
    "build:server": "node scripts/build_worker.mjs && vue-tsc --noEmit && vite build --base=/ --outDir=dist-server && node scripts/build_retirement_worker.mjs dist-server"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "onnxruntime-web": "1.23.2",
    "three": "0.186.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.1",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.1.1"
  }
}
